# Normalise line endings so the repo stores LF regardless of the machine that
# committed. Without this, a checkout on macOS or Linux after a Windows commit
# shows every line of every file as changed, and diffs become unreadable.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.apk binary
*.aab binary
*.ipa binary
