# Supabase — Safeco Taxi Booking
# Copy this file to `.env` in this same directory and fill in the values from
# the Supabase dashboard (Project Settings -> API).
#
# Both values are inlined into the app bundle at build time and are readable by
# anyone who inspects the app. That is expected and safe: the anon key is
# DESIGNED to be public, and row-level security — not key secrecy — is what
# protects the data. NEVER put the service_role key in here.
#
# Because values are inlined at build time, a warm reload will not pick up an
# edit. Restart the dev server:  npx expo start --clear

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
